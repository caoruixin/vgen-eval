# /etc/vgen/vgen.env (root:vgenapp 0640), read by vgen.service.
# Public mode: this server holds NO Tokenbay key. Visitors generate with their own key, kept in memory only.
VGEN_PUBLIC=1
TOKENBAY_BASE_URL=https://api.tokenbay.com
TOKENBAY_REQUESTS_PER_MINUTE=15
TOKENBAY_HTTP_TRUST_ENV=false
VGEN_ALLOWED_HOSTS=video.llm-pro.cn
VGEN_DATA_DIR=/var/lib/vgen/data
VGEN_HOST=127.0.0.1
VGEN_PORT=8790
VGEN_PUBLIC_MAX_ACTIVE_RUNS=2
